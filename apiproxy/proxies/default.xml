<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>SF-ValidateAccessToken</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="virginpulse">
            <Description>API  to fetch member reward information</Description>
            <Request>
                <Step>
                    <Name>EV-ExtractMemberId</Name>
                </Step>
                <Step>
                    <Name>SF-GetVirginpulseToken</Name>
                </Step>
                <Step>
                    <Name>LC-LookupExternalMemberIdCache</Name>
                </Step>
                <Step>
                    <Name>SC-GetExternalMemberId</Name>
                    <Condition>( virginpulse.externalMemberId == null )</Condition>
                </Step>
                <Step>
                    <Name>EV-ExtractExternalMemberId</Name>
                    <Condition>( virginpulse.externalMemberId == null )</Condition>
                </Step>
                <Step>
                    <Name>PC-PopulateExternalMemberIdCache</Name>
                    <condition>( virginpulse_getExternalMemberId_response != null )</condition>
                </Step>
            </Request>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/virginpulse/{memberId}") and (request.verb = "GET")</Condition>
        </Flow>
        <Flow name="OptionsPreFlight">
            <Description>communication options for a given URL or server</Description>
            <Request/>
            <Response/>
            <Condition>(request.verb = "OPTIONS")</Condition>
        </Flow>
        <Flow name="UnknownRequest">
            <Description>Flow to reject unknown calls</Description>
            <Request>
                <Step>
                    <Name>RF-UnknownRequest</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/member/webout/v1/incentives</BasePath>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="NoRoute">
        <Condition>request.verb == "OPTIONS"</Condition>
    </RouteRule>
    <RouteRule name="virginpulse">
        <TargetEndpoint>virginpulse</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>