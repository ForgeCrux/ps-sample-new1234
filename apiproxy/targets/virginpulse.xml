<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="virginpulse">
    <Description/>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request>
            <Step>
                <Name>JS-FixTargetPath</Name>
            </Step>
        </Request>
        <Response/>
    </PostFlow>
    <Flows/>
    <HTTPTargetConnection>
        <SSLInfo>
            <Enabled>true</Enabled>
        </SSLInfo>
        <Properties>
            <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
        </Properties>
        <LoadBalancer>
            <Server name="TS-Virginpulse"/>
        </LoadBalancer>
        <Path>{mytarget.path}</Path>
    </HTTPTargetConnection>
</TargetEndpoint>